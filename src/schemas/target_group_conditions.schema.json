{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.cloudbees.com/sdp/casc-fm-validate-action/target_group_conditions.schema.json",
  "title": "CasC target group conditions Definition",
  "description": "Adapted from flag-service target_group_conditions.schema.json: CasC references nested target groups by name, not id.",
  "type": "object",
  "properties": {
    "allOf": { "$ref": "#/$defs/nestedArray" },
    "anyOf": { "$ref": "#/$defs/nestedArray" },
    "not": { "$ref": "#/$defs/not" },
    "property": { "$ref": "#/$defs/property" },
    "group": { "$ref": "#/$defs/group" }
  },
  "additionalProperties": false,
  "$defs": {
    "nestedArray": {
      "type": "array",
      "items": {
        "properties": {
          "allOf": { "$ref": "#/$defs/nestedArray" },
          "anyOf": { "$ref": "#/$defs/nestedArray" },
          "not": { "$ref": "#/$defs/not" },
          "property": { "$ref": "#/$defs/property" },
          "group": { "$ref": "#/$defs/group" }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "not": {
      "type": "object",
      "properties": {
        "allOf": { "$ref": "#/$defs/nestedArray" },
        "anyOf": { "$ref": "#/$defs/nestedArray" },
        "property": { "$ref": "#/$defs/property" },
        "group": { "$ref": "#/$defs/group" }
      },
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1
    },
    "property": {
      "$ref": "https://www.cloudbees.com/sdp/flag-service/common.schema.json#/$defs/propertyCondition"
    },
    "group": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["name"],
      "additionalProperties": false
    }
  }
}
