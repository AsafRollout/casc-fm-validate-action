{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.cloudbees.com/sdp/casc-fm-validate-action/target_group.schema.json",
  "title": "CasC target group Configuration Definition",
  "description": "Adapted from flag-service target_group.schema.json for the CasC target-groups/*.yaml shape.",
  "type": "object",
  "properties": {
    "apiVersion": { "type": "string" },
    "kind": { "const": "target-group" },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": { "type": "string" },
    "conditions": {
      "$ref": "https://www.cloudbees.com/sdp/casc-fm-validate-action/target_group_conditions.schema.json"
    }
  },
  "additionalProperties": false,
  "required": ["name", "conditions"]
}
