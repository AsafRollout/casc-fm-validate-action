{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.cloudbees.com/sdp/casc-fm-validate-action/flag_configuration_optional.schema.json",
  "title": "CasC flag Configuration Optional Definition",
  "description": "Adapted from flag-service flag_configuration_optional.schema.json for the CasC flag-configurations/<env>/*.yaml shape.",
  "$ref": "#/$defs/flagConfigOptional",
  "$defs": {
    "flagConfigOptional": {
      "type": "object",
      "properties": {
        "apiVersion": { "type": "string" },
        "kind": { "const": "flag-configuration" },
        "flag": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the flag this configuration applies to. Must exist in flags/"
        },
        "enabled": {
          "type": "boolean"
        },
        "stickinessProperty": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "string"
        },
        "defaultValue": {
          "$ref": "https://www.cloudbees.com/sdp/flag-service/flag_value.schema.json#/$defs/flagValue"
        },
        "conditions": {
          "$ref": "https://www.cloudbees.com/sdp/casc-fm-validate-action/flag_conditions.schema.json"
        }
      },
      "additionalProperties": false
    }
  }
}
